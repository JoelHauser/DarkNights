<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net472 because that is what the game's mono runtime loads. -->
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>DarkNights.Client</RootNamespace>
    <AssemblyName>DarkNights.Client</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>

    <!-- Must match DarkNightsPlugin.PluginVersion. Two places, and they have to agree. -->
    <Version>0.1.9</Version>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <SPTPath Condition="'$(SPTPath)' == ''">C:\HUH</SPTPath>
    <GameManaged>$(SPTPath)\EscapeFromTarkov_Data\Managed</GameManaged>
    <BepInExCore>$(SPTPath)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <Target Name="ValidateSPTPath" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(BepInExCore)\BepInEx.dll')"
           Text="SPTPath ('$(SPTPath)') is not an SPT install root: no BepInEx\core\BepInEx.dll." />
  </Target>

  <!--
    Deliberately NOT referenced: Assembly-CSharp. The copy in Managed is the unpatched
    original on any install that has never been launched, and the SPT Launcher's delta
    renames obfuscated types, so a plugin compiled against it does not load. Every game
    member is resolved by name at runtime instead; see GameTypes.cs. Nothing below is the
    game's own code.
  -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      The facade. BepInEx's BaseUnityPlugin derives from MonoBehaviour as typed against
      this assembly, so the compile needs it even though every type used lives in CoreModule.
    -->
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- MonoBehaviour, Light, Color, Vector3, Mathf, SphericalHarmonicsL2, KeyCode. -->
    <!-- Physics.Raycast, for how much daylight reaches where you stand (Daylight.cs). -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameManaged)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
